# syntax=docker/dockerfile:1
# Image de tests d'intégration (pytest), jamais publiée.
# Contexte filtré par Dockerfile.test.dockerignore.
FROM cgr.dev/chainguard/python:latest-dev@sha256:894aed3297d91283e1fc4c542f5374a4b5f3726134fda7c94eaa539342be1e05

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /tests

COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir --user -r requirements-dev.txt

COPY app.py test_app.py pytest.ini ./

USER 65532:65532

ENTRYPOINT ["/usr/bin/python", "-m", "pytest", "-v", "-p", "no:cacheprovider"]
